{
  "manifest_version": 3,
  "name": "3mukon-code Browser Connector",
  "version": "0.1.0",
  "description": "Connect this Chrome profile to 3mukon-code for its own task tabs.",
  "minimum_chrome_version": "158",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/chrome-setup/*"] },
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
