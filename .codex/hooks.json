{
  "description": "Guards for Codex sessions in this repository: the bypass guard before shell commands and the protected-path guard before patches. Every failure exits 2, which blocks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/guard/bypass-guard.sh\" || exit 2",
            "timeout": 10,
            "statusMessage": "Checking for hook bypasses"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/guard/protected-paths-guard.sh\" || exit 2",
            "timeout": 10,
            "statusMessage": "Checking for protected files"
          }
        ]
      }
    ]
  }
}
