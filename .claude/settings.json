{
  "permissions": {
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/LICENSE)",
      "Edit(/docs/architecture.md)",
      "Edit(/.github/workflows/**)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/.gitleaks.toml)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/scripts/check.sh)",
      "Edit(/scripts/checks/**)",
      "Edit(/scripts/guard/**)",
      "Edit(/.git/hooks/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/guard/bypass-guard.sh"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
